<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Livingston Power Solutions</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #f4f7fb;
    color: #172033;
}

header {
    background: #101d35;
    color: white;
    padding: 22px 15px;
    text-align: center;
}

header h1 {
    margin: 0;
    font-size: 28px;
}

header p {
    color: #ffca28;
}

nav {
    background: #17345c;
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
    padding: 12px;
}

nav button {
    background: transparent;
    color: white;
    border: 1px solid #55749b;
    padding: 10px 13px;
    border-radius: 5px;
    cursor: pointer;
}

nav button:hover {
    background: #087f8c;
}

.container {
    max-width: 1100px;
    margin: auto;
    padding: 20px;
}

.hero {
    background: linear-gradient(120deg, #123c69, #087f8c);
    color: white;
    padding: 45px 20px;
    text-align: center;
    border-radius: 12px;
}

.hero h2 {
    font-size: 32px;
}

.button {
    background: #087f8c;
    color: white;
    border: none;
    padding: 11px 16px;
    border-radius: 5px;
    cursor: pointer;
    margin: 4px;
}

.button:hover {
    background: #065f67;
}

.secondary {
    background: #17345c;
}

.danger {
    background: #b42318;
}

input, select, textarea {
    width: 100%;
    padding: 11px;
    margin: 7px 0 14px;
    border: 1px solid #ccd5e0;
    border-radius: 5px;
    font-size: 15px;
}

label {
    font-weight: bold;
}

.products {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 18px;
}

.card {
    background: white;
    border-radius: 10px;
    padding: 18px;
    box-shadow: 0 3px 12px #00000010;
}

.card h3 {
    color: #17345c;
}

.price {
    font-size: 20px;
    font-weight: bold;
    color: #087f8c;
}

.badge {
    display: inline-block;
    padding: 5px 9px;
    border-radius: 12px;
    background: #e2f4ed;
    color: #146c43;
    font-size: 12px;
}

section {
    margin-bottom: 28px;
}

.panel {
    background: white;
    padding: 20px;
    border-radius: 10px;
    margin: 15px 0;
}

.order {
    border-left: 5px solid #087f8c;
    background: white;
    padding: 15px;
    margin: 12px 0;
    border-radius: 5px;
}

.hidden {
    display: none;
}

.notice {
    background: #fff4cc;
    padding: 12px;
    border-radius: 5px;
}

footer {
    background: #101d35;
    color: white;
    padding: 25px;
    text-align: center;
    margin-top: 35px;
}

footer a {
    color: #ffca28;
}

@media(max-width: 600px) {
    header h1 {
        font-size: 23px;
    }

    .hero h2 {
        font-size: 25px;
    }

    .container {
        padding: 12px;
    }
}
</style>
</head>

<body>

<header>
    <h1>⚡ LIVINGSTON POWER SOLUTIONS</h1>
    <p>Your Trusted Solar & Electrical Partner</p>
    <p>Powering Homes, Businesses and Industries</p>
</header>

<nav>
    <button onclick="showPage('home')">Home</button>
    <button onclick="showPage('shop')">Our Products</button>
    <button onclick="showPage('cart')">Cart (<span id="cartCount">0</span>)</button>
    <button onclick="showPage('account')">My Account</button>
    <button onclick="showPage('orders')">My Orders</button>
    <button onclick="showPage('admin')">Admin</button>
</nav>

<main class="container">

<!-- HOME PAGE -->
<section id="home">
    <div class="hero">
        <h2>Welcome to Livingston Power Solutions</h2>
        <p>Your one-stop shop for solar systems and electrical materials.</p>
        <p>Quality products. Reliable power. Professional service.</p>
        <button class="button" onclick="showPage('shop')">
            Explore Our Products
        </button>
    </div>

